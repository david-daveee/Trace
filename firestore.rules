rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function owns(uid) { return signed() && request.auth.uid == uid; }
  function accepted(a,b) {
   return (exists(/databases/$(database)/documents/connections/$(a + '~' + b)) && get(/databases/$(database)/documents/connections/$(a + '~' + b)).data.status == 'accepted')
    || (exists(/databases/$(database)/documents/connections/$(b + '~' + a)) && get(/databases/$(database)/documents/connections/$(b + '~' + a)).data.status == 'accepted');
  }
  function friend(uid) { return signed() && accepted(uid,request.auth.uid); }
  function shared(uid,item) {
   let privacy = exists(/databases/$(database)/documents/social/$(uid)/settings/privacy) ? get(/databases/$(database)/documents/social/$(uid)/settings/privacy).data : {};
   return friend(uid) && item.visible == true
    && (item.get('individualPrivacy',false) == true || (item.kind == 'plan' && privacy.plansVisible == true) || (item.kind == 'walk' && privacy.walksVisible == true))
    && (item.audience == 'friends' || (item.audience == 'direct' && request.auth.uid in item.recipients));
  }
  // Friends NEVER receive access to the private backup namespace.
  match /users/{uid}/sync/{document} { allow read, write: if owns(uid); }
  match /users/{uid}/revisions/{revision} {
   allow read, write: if owns(uid);
   match /chunks/{chunk} { allow read, write: if owns(uid); }
  }
  // Moderation is restricted to the project owner's Trace account, never a client role flag.
  function catalogAdmin() { return signed() && request.auth.uid == 'I8mrFaI4vhXFpGOM8Dxmg4mOf7w1'; }
  function submissionFields(d) {
   return d.keys().hasAll(['owner','authorName','authorAvatar','planKey','title','payload','sha256','status','reason','submittedAt'])
    && d.keys().hasOnly(['owner','authorName','authorAvatar','planKey','title','payload','sha256','status','reason','submittedAt'])
    && d.owner == request.auth.uid && d.authorName is string && d.authorName.size()>0 && d.authorName.size()<=40
    && d.authorAvatar is string && d.authorAvatar.size()<=160000 && d.planKey.matches('[a-f0-9]{64}')
    && d.title is string && d.title.size()>0 && d.title.size()<=120
    && d.payload is bytes && d.payload.size()>0 && d.payload.size()<=700000 && d.sha256.matches('[a-f0-9]{64}')
    && d.status == 'pending' && d.reason == '' && d.submittedAt == request.time;
  }
  match /catalogSubmissions/{id} {
   allow get: if catalogAdmin() || (signed() && (resource.data.owner == request.auth.uid || id.matches(request.auth.uid + '~[a-f0-9]{64}')));
   allow list: if signed() && request.query.limit<=100 && (catalogAdmin() || resource.data.owner == request.auth.uid);
   allow create: if signed() && submissionFields(request.resource.data) && id == request.auth.uid + '~' + request.resource.data.planKey;
   allow update: if (owns(resource.data.owner) && resource.data.status != 'pending' && submissionFields(request.resource.data)
      && request.resource.data.owner == resource.data.owner && request.resource.data.planKey == resource.data.planKey)
    || (catalogAdmin() && resource.data.status == 'pending'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reason'])
      && request.resource.data.status in ['approved','rejected'] && request.resource.data.reason is string
      && request.resource.data.reason.size()<=400 && (request.resource.data.status == 'approved' || request.resource.data.reason.size()>0))
    || (catalogAdmin() && resource.data.status == 'pending'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','payload','sha256'])
      && validCatalogContent(request.resource.data));
  }
  function validCatalogContent(d) {
   return d.title is string && d.title.size()>0 && d.title.size()<=120
    && d.payload is bytes && d.payload.size()>0 && d.payload.size()<=700000 && d.sha256.matches('[a-f0-9]{64}');
  }
  match /publicPlans/{id} {
   allow get: if true;
   allow list: if request.query.limit<=100;
   // A moderator may fix content but cannot transfer authorship or vote identity.
   allow update: if catalogAdmin() && validCatalogContent(request.resource.data)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','payload','sha256','publishedAt'])
    && request.resource.data.publishedAt == request.time;
   // Built-in plans can receive a public override without a user submission.
   allow create: if catalogAdmin() && validCatalogContent(request.resource.data)
    && id.matches('[a-f0-9]{64}') && request.resource.data.planKey == id
    && request.resource.data.keys().hasAll(['owner','authorName','authorAvatar','planKey','title','payload','sha256','submittedAt','requestId','publishedAt'])
    && request.resource.data.keys().hasOnly(['owner','authorName','authorAvatar','planKey','title','payload','sha256','submittedAt','requestId','publishedAt'])
    && request.resource.data.owner == request.auth.uid && request.resource.data.authorName == 'Trace'
    && request.resource.data.authorAvatar == '' && request.resource.data.requestId == request.auth.uid + '~' + id
    && request.resource.data.submittedAt == request.time && request.resource.data.publishedAt == request.time;

   allow create, update: if catalogAdmin()
    && (!exists(/databases/$(database)/documents/publicPlans/$(id)) || request.resource.data.owner == resource.data.owner)
    && request.resource.data.keys().hasOnly(['owner','authorName','authorAvatar','planKey','title','payload','sha256','submittedAt','requestId','publishedAt'])
    && request.resource.data.planKey == id
    && request.resource.data.requestId == request.resource.data.owner + '~' + id
    && request.resource.data.title == get(/databases/$(database)/documents/catalogSubmissions/$(request.resource.data.requestId)).data.title
    && request.resource.data.submittedAt == get(/databases/$(database)/documents/catalogSubmissions/$(request.resource.data.requestId)).data.submittedAt
    && request.resource.data.publishedAt == request.time
    && getAfter(/databases/$(database)/documents/catalogSubmissions/$(request.resource.data.requestId)).data.status == 'approved'
    && request.resource.data.payload == get(/databases/$(database)/documents/catalogSubmissions/$(request.resource.data.requestId)).data.payload
    && request.resource.data.sha256 == get(/databases/$(database)/documents/catalogSubmissions/$(request.resource.data.requestId)).data.sha256
    && request.resource.data.owner == get(/databases/$(database)/documents/catalogSubmissions/$(request.resource.data.requestId)).data.owner
    && request.resource.data.authorName == get(/databases/$(database)/documents/catalogSubmissions/$(request.resource.data.requestId)).data.authorName
    && request.resource.data.authorAvatar == get(/databases/$(database)/documents/catalogSubmissions/$(request.resource.data.requestId)).data.authorAvatar;
  }
  // Public counts only. Individual votes can only be read and changed by their owner.
  match /planLikes/{plan} {
   function oldVote() { return exists(/databases/$(database)/documents/planLikes/$(plan)/votes/$(request.auth.uid)) && get(/databases/$(database)/documents/planLikes/$(plan)/votes/$(request.auth.uid)).data.liked; }
   function nextVote() { return getAfter(/databases/$(database)/documents/planLikes/$(plan)/votes/$(request.auth.uid)).data.liked; }
   function validCount() { return plan.matches('[a-f0-9]{64}') && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count is int && request.resource.data.count >= 0; }
   allow get: if true;
   allow create: if signed() && validCount() && request.resource.data.count == 1 && !oldVote() && nextVote() == true;
   allow update: if signed() && validCount() && nextVote() != oldVote()
    && request.resource.data.count == resource.data.count + (nextVote() ? 1 : -1);
   match /votes/{uid} {
    function beforeCount() { return exists(/databases/$(database)/documents/planLikes/$(plan)) ? get(/databases/$(database)/documents/planLikes/$(plan)).data.count : 0; }
    function beforeVote() { return exists(/databases/$(database)/documents/planLikes/$(plan)/votes/$(uid)) && get(/databases/$(database)/documents/planLikes/$(plan)/votes/$(uid)).data.liked; }
    allow get: if owns(uid);
    allow create, update: if owns(uid) && plan.matches('[a-f0-9]{64}')
     && request.resource.data.keys().hasOnly(['liked']) && request.resource.data.liked is bool
     && request.resource.data.liked != beforeVote()
     && getAfter(/databases/$(database)/documents/planLikes/$(plan)).data.count == beforeCount() + (request.resource.data.liked ? 1 : -1);
   }
  }
  match /socialProfiles/{uid} {
   allow get: if owns(uid);
   allow create: if owns(uid) && request.resource.data.keys().hasOnly(['uid','name','code'])
    && request.resource.data.uid == uid && request.resource.data.name is string
    && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
    && request.resource.data.code.matches('[A-F0-9]{12}')
    && getAfter(/databases/$(database)/documents/friendCodes/$(request.resource.data.code)).data.uid == uid;
  }
  match /friendCodes/{code} {
   allow get: if signed();
   allow create: if signed() && request.resource.data.keys().hasOnly(['uid','name','code'])
    && request.resource.data.uid == request.auth.uid && request.resource.data.code == code
    && code.matches('[A-F0-9]{12}')
    && getAfter(/databases/$(database)/documents/socialProfiles/$(request.auth.uid)).data == request.resource.data;
   // Exact-code lookup only: the directory cannot be listed or overwritten.
  }
  // Exact Gmail lookup is opt-in; no directory listing or address impersonation.
  match /friendEmails/{email} {
   function ownEmail() { return signed() && request.auth.token.email_verified == true && request.auth.token.email.lower() == email; }
   allow get: if ownEmail() || (signed() && resource.data.enabled == true);
   allow create, update: if ownEmail() && email.matches('[a-z0-9._+\\-]+@gmail[.]com')
    && request.resource.data.keys().hasAll(['uid','code','enabled']) && request.resource.data.keys().hasOnly(['uid','code','enabled'])
    && request.resource.data.uid == request.auth.uid && request.resource.data.enabled is bool
    && request.resource.data.code == get(/databases/$(database)/documents/socialProfiles/$(request.auth.uid)).data.code;
  }
  match /connections/{id} {
   allow get: if signed() && request.auth.uid in id.split('~');
   allow list: if signed() && request.auth.uid in resource.data.members && request.query.limit <= 100;
   allow create: if signed() && request.resource.data.keys().hasOnly(['from','to','fromName','toName','members','status','createdAt'])
    && request.resource.data.from == request.auth.uid && request.resource.data.to != request.auth.uid
    && request.resource.data.to.matches('[a-zA-Z0-9_-]{1,128}')
    && id == request.auth.uid + '~' + request.resource.data.to
    && request.resource.data.members == [request.auth.uid,request.resource.data.to]
    && request.resource.data.status == 'pending' && request.resource.data.createdAt is int
    && request.resource.data.fromName == get(/databases/$(database)/documents/socialProfiles/$(request.auth.uid)).data.name
    && request.resource.data.toName == get(/databases/$(database)/documents/socialProfiles/$(request.resource.data.to)).data.name
    && !exists(/databases/$(database)/documents/connections/$(request.resource.data.to + '~' + request.auth.uid));
   allow update: if signed() && request.auth.uid == resource.data.to && resource.data.status == 'pending'
    && request.resource.data.status == 'accepted' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
   allow delete: if signed() && request.auth.uid in resource.data.members;
  }
  match /connections/{id}/messages/{message} {
   function member() { let c = get(/databases/$(database)/documents/connections/$(id)).data; return signed() && c.status == 'accepted' && request.auth.uid in c.members; }
   allow get: if member();
   allow list: if member() && request.query.limit <= 100;
   function walkCard() {
    let d = request.resource.data;
    let c = get(/databases/$(database)/documents/connections/$(id)).data;
    let w = get(/databases/$(database)/documents/social/$(request.auth.uid)/items/$(d.walkItem)).data;
    let peer = c.from == request.auth.uid ? c.to : c.from;
    return d.keys().hasOnly(['sender','text','sentAt','kind','walkOwner','walkItem'])
     && d.kind == 'walk' && d.walkOwner == request.auth.uid
     && d.walkItem is string && d.walkItem.matches('walk-[a-f0-9]{64}(-[a-f0-9]{64})?')
     && w.kind == 'walk' && w.visible == true && w.individualPrivacy == true
     && (w.audience == 'friends' || (w.audience == 'direct' && peer in w.recipients));
   }
   allow create: if member() && (request.resource.data.keys().hasOnly(['sender','text','sentAt']) || walkCard())
    && request.resource.data.sender == request.auth.uid
    && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
    && request.resource.data.sentAt == request.time;
  }
  // Voluntary display name, short bio and avatar, visible to confirmed friends only.
  match /social/{uid}/settings/profile {
   allow get: if owns(uid) || friend(uid);
   allow create, update: if owns(uid) && request.resource.data.keys().hasOnly(['displayName','bio','avatar'])
    && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 40))
    && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 160))
    && (!('avatar' in request.resource.data) || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 160000));
  }
  match /social/{uid}/settings/privacy {
   allow get: if owns(uid) || friend(uid);
   allow create, update: if owns(uid) && request.resource.data.keys().hasOnly(['plansVisible','walksVisible'])
    && request.resource.data.plansVisible is bool && request.resource.data.walksVisible is bool;
  }
  match /social/{uid}/items/{itemId} {
   allow get: if owns(uid) || shared(uid,resource.data);
   allow list: if request.query.limit <= 100 && (owns(uid) || shared(uid,resource.data));
   allow create, update: if owns(uid)
    && request.resource.data.keys().hasOnly(['kind','name','audience','recipients','visible','revision','bytes','chunks','sha256','updatedAt','routeShared','individualPrivacy'])
    && request.resource.data.kind in ['plan','walk'] && request.resource.data.name is string && request.resource.data.name.size() <= 120
    && request.resource.data.audience in ['friends','direct'] && request.resource.data.recipients is list && request.resource.data.recipients.size() <= 100
    && request.resource.data.visible is bool && request.resource.data.routeShared is bool
    && (!('individualPrivacy' in request.resource.data) || request.resource.data.individualPrivacy is bool)
    && request.resource.data.revision.matches('[a-f0-9-]{36}')
    && request.resource.data.bytes is int && request.resource.data.bytes > 0 && request.resource.data.bytes <= 5242880
    && request.resource.data.chunks is int && request.resource.data.chunks > 0 && request.resource.data.chunks <= 20
    && request.resource.data.sha256.matches('[a-f0-9]{64}') && request.resource.data.updatedAt is int;
   allow delete: if owns(uid);
   match /revisions/{revision}/chunks/{chunk} {
    allow read: if owns(uid) || (shared(uid,get(/databases/$(database)/documents/social/$(uid)/items/$(itemId)).data)
     && get(/databases/$(database)/documents/social/$(uid)/items/$(itemId)).data.revision == revision);
    allow create, update: if owns(uid) && request.resource.data.keys().hasOnly(['data']) && request.resource.data.data is bytes && request.resource.data.data.size() <= 262144;
    allow delete: if owns(uid);
   }
  }
  match /{document=**} { allow read, write: if false; }
 }
}
