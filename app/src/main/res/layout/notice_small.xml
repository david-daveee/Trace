<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/notice_card" android:clipToOutline="true">
<ImageView android:id="@+id/notice_art" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no"/>
<ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/notice_shade" android:scaleType="fitXY" android:importantForAccessibility="no"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="6dp"><LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical"><LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="4dp" android:paddingEnd="8dp"><TextView android:id="@+id/notice_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#FFFFFF" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textStyle="bold"/><TextView android:id="@+id/notice_weight" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#BDE1D3" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="4dp"/></LinearLayout><ImageView android:id="@+id/notice_next" android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:background="@drawable/notice_button" android:src="@drawable/notice_next"/></LinearLayout></LinearLayout>
</FrameLayout>